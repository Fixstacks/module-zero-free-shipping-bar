 *
 * "Add $12.50 more for free shipping" with a progress bar, or "You've
 * unlocked free shipping!". `place` (minicart, cart, checkout) picks the
 * look; in the checkout the bar refetches itself when the cart changes.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Zero\FreeShippingBar\ViewModel\Bar $viewModel */
$viewModel = $block->getData('viewModel');
$place = (string) $block->getData('place');
$bar = $viewModel->bar($place);
if ($bar === null) {
    return;
}
?>
<div class="free-shipping-bar free-shipping-bar-<?= $escaper->escapeHtmlAttr($place) ?><?= $bar['unlocked'] ? ' is-unlocked' : '' ?>"
     data-free-shipping-bar="<?= $escaper->escapeHtmlAttr($place) ?>"
     data-remaining="<?= $escaper->escapeHtmlAttr($bar['remaining']) ?>"
    <?php if ($place === 'checkout') : ?>
     hx-get="<?= $escaper->escapeUrl($viewModel->url($place)) ?>"
     hx-trigger="cart:updated from:body"
     hx-swap="outerHTML"
    <?php endif; ?>>
    <p class="free-shipping-bar-text">
        <svg class="free-shipping-bar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <?php if ($bar['unlocked']) : ?>
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            <?php else : ?>
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            <?php endif; ?>
        </svg>
        <span><?= $escaper->escapeHtml($bar['text']) ?></span>
    </p>
    <progress class="progress free-shipping-bar-progress" value="<?= (int) $bar['percent'] ?>" max="100"
              aria-label="<?= $escaper->escapeHtmlAttr(__('%1 of the %2 for free shipping', $bar['percent'] . '%', $bar['threshold'])) ?>"></progress>
</div>
