    The bar in the cart summary, under its title.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="cart.summary">
            <block class="Magento\Framework\View\Element\Template" name="zero.free.shipping.cart" after="checkout.cart.summary.title" template="Zero_FreeShippingBar::bar.phtml">
                <arguments>
                    <argument name="viewModel" xsi:type="object">Zero\FreeShippingBar\ViewModel\Bar</argument>
                    <argument name="place" xsi:type="string">cart</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
