    The bar in the order summary, above the discount code; it refetches
    itself on `cart:updated` (a discount code changes the subtotal).
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="zero.checkout.summary.totals.before">
            <block class="Magento\Framework\View\Element\Template" name="zero.free.shipping.checkout" before="-" template="Zero_FreeShippingBar::bar.phtml">
                <arguments>
                    <argument name="viewModel" xsi:type="object">Zero\FreeShippingBar\ViewModel\Bar</argument>
                    <argument name="place" xsi:type="string">checkout</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
